{
  "name": "canwesynth-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/canwesynth/mcp-server"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "build:codex-plugin": "bun run --cwd plugins/canwesynth/mcp-server build",
    "canwesynth": "bun run packages/cli/src/index.ts",
    "fmt": "bunx prettier --write \"{apps,packages,plugins}/**/*.{ts,json,md}\"",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.2.22",
    "@types/node": "24.3.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
